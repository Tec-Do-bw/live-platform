# ===========================================
# liveSpider_Serverv2 节点配置示例
# 复制此文件为 .env 并修改配置
# ===========================================

# ========== 节点配置 ==========
# 节点ID: node1=主节点(优先级高), node2=备节点(优先级低)
NODE_ID=node1

# 节点IP地址
NODE_IP=127.0.0.1

# 节点优先级(数值越大优先级越高)
# 主节点: 100, 备节点: 50
PRIORITY=100

# 备用节点URL地址
# 主节点填写备节点地址，备节点填写主节点地址
# 主机1: http://47.236.42.104:8080
# 主机2: http://47.237.6.199:8080
BACKUP_NODE_URL=

# ========== 环境配置 ==========
# 环境标识: 0=生产环境, 1=测试环境
ISTEST=1

# ===========================================
# 配置说明:
# 
# 主机1 (47.237.6.199) 配置:
#   NODE_ID=node1
#   NODE_IP=47.237.6.199
#   PRIORITY=100
#   BACKUP_NODE_URL=http://47.236.42.104:8080
#
# 主机2 (47.236.42.104) 配置:
#   NODE_ID=node2
#   NODE_IP=47.236.42.104
#   PRIORITY=50
#   BACKUP_NODE_URL=http://47.237.6.199:8080
# ===========================================

